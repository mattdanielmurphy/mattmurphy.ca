{
	"crons": [
		{
			"path": "/api/cron/keep-alive",
			"schedule": "0 0 * * *"
		}
	],
	"redirects": [
		{
			"source": "/subtitles",
			"destination": "https://netflix-subtitle-display.vercel.app",
			"permanent": true
		}
	],
	"rewrites": [
		{
			"source": "/tv-box",
			"destination": "/tv-box/index.html"
		},
		{
			"source": "/slub-call-2026-10-24",
			"destination": "/slub-call-2026-10-24/index.html"
		},
		{
			"source": "/claude/:project/:thread",
			"destination": "/claude/:project/:thread/index.html"
		},
		{
			"source": "/coordinator-instructions",
			"destination": "/coordinator-instructions/index.html"
		}
	],
	"headers": [
		{
			"source": "/claude/(.*)",
			"headers": [
				{
					"key": "X-Robots-Tag",
					"value": "noindex, nofollow"
				}
			]
		}
	]
}
