{
	"crons": [
		{
			"path": "/api/cron/keep-alive",
			"schedule": "0 0 * * *"
		}
	],
	"redirects": [
		{
			"source": "/subtitles",
			"destination": "https://netflix-subtitle-display.vercel.app",
			"permanent": true
		}
	],
	"rewrites": [
		{
			"source": "/tv-box",
			"destination": "/tv-box/index.html"
		},
		{
			"source": "/slub-call-2026-10-24",
			"destination": "/slub-call-2026-10-24/index.html"
		}
	]
}
